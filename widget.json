{
  "id": "com.custom.navtabs",
  "version": "1.0.0",
  "name": "Navigation Tabs",
  "description": "Tab bar with page tabs on the left and story links on the right",
  "newInstancePrefix": "NavTabs",
  "vendor": "Custom",
  "eula": "",
  "license": "",
  "icon": "",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-custom-navtabs",
      "url": "https://github.com/nourmansourrr/panel/blob/4bf73b0847144156e4492e76b2c0d86ef5585ad5/main.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "builder",
      "tag": "com-custom-navtabs-builder",
      "url": "https://github.com/nourmansourrr/panel/blob/4bf73b0847144156e4492e76b2c0d86ef5585ad5/builder.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-custom-navtabs-styling",
      "url": "https://github.com/nourmansourrr/panel/blob/4bf73b0847144156e4492e76b2c0d86ef5585ad5/styling.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "width":  { "type": "integer", "default": 900 },
    "height": { "type": "integer", "default": 56 },

    "tabsJson":  { "type": "string", "default": "[{\"id\":\"overview\",\"label\":\"Overview\"},{\"id\":\"pl\",\"label\":\"P&L\"},{\"id\":\"cashflow\",\"label\":\"Cash Flow\"},{\"id\":\"balance\",\"label\":\"Balance Sheet\"}]" },
    "linksJson": { "type": "string", "default": "[{\"id\":\"group\",\"label\":\"Group Performance\",\"storyId\":\"\",\"pageId\":\"\",\"newTab\":false},{\"id\":\"company\",\"label\":\"Company Performance\",\"storyId\":\"\",\"pageId\":\"\",\"newTab\":false}]" },
    "selectedTab": { "type": "string", "default": "overview" },
    "activeLink":  { "type": "string", "default": "company" },

    "fontFamily":        { "type": "string",  "default": "Inter, 'Segoe UI', Arial, sans-serif" },
    "fontSize":          { "type": "integer", "default": 16 },
    "activeFontWeight":  { "type": "integer", "default": 600 },
    "inactiveFontWeight":{ "type": "integer", "default": 500 },
    "backgroundColor":   { "type": "string",  "default": "#ffffff" },
    "activeColor":       { "type": "string",  "default": "#1b2a3b" },
    "inactiveColor":     { "type": "string",  "default": "#6b7a8c" },
    "hoverColor":        { "type": "string",  "default": "#1b2a3b" },
    "underlineColor":    { "type": "string",  "default": "#1b2a3b" },
    "underlineThickness":{ "type": "integer", "default": 3 },
    "baselineColor":     { "type": "string",  "default": "#1b2a3b" },
    "baselineThickness": { "type": "integer", "default": 2 },
    "dividerColor":      { "type": "string",  "default": "#e3e6ea" },
    "showEdgeLine":      { "type": "boolean", "default": true },
    "showLinkDivider":   { "type": "boolean", "default": true },
    "tabGap":            { "type": "integer", "default": 28 },
    "tabPaddingX":       { "type": "integer", "default": 8 },
    "leftOffset":        { "type": "integer", "default": 24 },
    "linkPaddingX":      { "type": "integer", "default": 16 },
    "rightOffset":       { "type": "integer", "default": 16 }
  },
  "methods": {
    "getSelectedTab": {
      "description": "Returns the id of the currently selected tab",
      "returnType": "string",
      "body": "return this.getSelectedTab();"
    },
    "setSelectedTab": {
      "description": "Selects a tab by id",
      "parameters": [{ "name": "tabId", "type": "string", "description": "Tab id" }],
      "body": "this.setSelectedTab(tabId);"
    },
    "getClickedLinkLabel":   { "description": "Label of the last clicked right-hand link", "returnType": "string",  "body": "return this.getClickedLinkLabel();" },
    "getClickedLinkStoryId": { "description": "Story id of the last clicked link",          "returnType": "string",  "body": "return this.getClickedLinkStoryId();" },
    "getClickedLinkPageId":  { "description": "Page id of the last clicked link",           "returnType": "string",  "body": "return this.getClickedLinkPageId();" },
    "getClickedLinkNewTab":  { "description": "Whether the link should open in a new tab",  "returnType": "boolean", "body": "return this.getClickedLinkNewTab();" }
  },
  "events": {
    "onTabSelect": { "description": "Fires when a left-hand tab is selected" },
    "onLinkClick": { "description": "Fires when a right-hand link is clicked" }
  }
}
