{
  "id": "com.custom.navtabs2",
  "version": "1.0.0",
  "name": "Navigation Tabs 2",
  "description": "Tab bar with page tabs and story links that open the matching page of the other story",
  "newInstancePrefix": "NavTabs2",
  "vendor": "Custom",
  "eula": "",
  "license": "",
  "icon": "",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-custom-navtabs2",
      "url": "https://nourmansourrr.github.io/panel/navtabs2/main.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "builder",
      "tag": "com-custom-navtabs2-builder",
      "url": "https://nourmansourrr.github.io/panel/navtabs2/builder.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-custom-navtabs2-styling",
      "url": "https://nourmansourrr.github.io/panel/navtabs2/styling.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "width": {
      "type": "integer",
      "default": 900
    },
    "height": {
      "type": "integer",
      "default": 56
    },
    "tabsJson": {
      "type": "string",
      "default": "[{\"id\":\"overview\",\"label\":\"Overview\",\"pageId\":\"\"},{\"id\":\"pl\",\"label\":\"P&L\",\"pageId\":\"\"},{\"id\":\"cashflow\",\"label\":\"Cash Flow\",\"pageId\":\"\"},{\"id\":\"balance\",\"label\":\"Balance Sheet\",\"pageId\":\"\"}]"
    },
    "linksJson": {
      "type": "string",
      "default": "[{\"id\":\"group\",\"label\":\"Group Performance\",\"storyId\":\"\",\"pageId\":\"\",\"newTab\":false},{\"id\":\"company\",\"label\":\"Company Performance\",\"storyId\":\"\",\"pageId\":\"\",\"newTab\":false}]"
    },
    "storyId": {
      "type": "string",
      "default": ""
    },
    "selectedTab": {
      "type": "string",
      "default": "overview"
    },
    "activeLink": {
      "type": "string",
      "default": "company"
    },
    "fontFamily": {
      "type": "string",
      "default": "Inter, 'Segoe UI', Arial, sans-serif"
    },
    "fontSize": {
      "type": "integer",
      "default": 16
    },
    "activeFontWeight": {
      "type": "integer",
      "default": 600
    },
    "inactiveFontWeight": {
      "type": "integer",
      "default": 500
    },
    "backgroundColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "activeColor": {
      "type": "string",
      "default": "#1b2a3b"
    },
    "inactiveColor": {
      "type": "string",
      "default": "#6b7a8c"
    },
    "hoverColor": {
      "type": "string",
      "default": "#1b2a3b"
    },
    "underlineColor": {
      "type": "string",
      "default": "#1b2a3b"
    },
    "underlineThickness": {
      "type": "integer",
      "default": 3
    },
    "baselineColor": {
      "type": "string",
      "default": "#1b2a3b"
    },
    "baselineThickness": {
      "type": "integer",
      "default": 2
    },
    "dividerColor": {
      "type": "string",
      "default": "#e3e6ea"
    },
    "showEdgeLine": {
      "type": "boolean",
      "default": true
    },
    "showLinkDivider": {
      "type": "boolean",
      "default": true
    },
    "tabGap": {
      "type": "integer",
      "default": 28
    },
    "tabPaddingX": {
      "type": "integer",
      "default": 8
    },
    "leftOffset": {
      "type": "integer",
      "default": 24
    },
    "linkPaddingX": {
      "type": "integer",
      "default": 16
    },
    "rightOffset": {
      "type": "integer",
      "default": 16
    },
    "selectedTabPageId": {
      "type": "string",
      "default": ""
    },
    "clickedLinkLabel": {
      "type": "string",
      "default": ""
    },
    "clickedLinkStoryId": {
      "type": "string",
      "default": ""
    },
    "clickedLinkPageId": {
      "type": "string",
      "default": ""
    },
    "clickedLinkNewTab": {
      "type": "boolean",
      "default": false
    }
  },
  "methods": {
    "getSelectedTab": {
      "description": "Returns the id of the currently selected tab",
      "returnType": "string",
      "body": "return this.selectedTab;"
    },
    "setSelectedTab": {
      "description": "Selects a tab by id",
      "parameters": [
        {
          "name": "tabId",
          "type": "string",
          "description": "Tab id"
        }
      ],
      "body": "this.selectedTab = tabId;"
    },
    "getStoryId": {
      "description": "Story id set in the builder panel",
      "returnType": "string",
      "body": "return this.storyId;"
    },
    "getSelectedTabPageId": {
      "description": "Page id assigned to the selected tab",
      "returnType": "string",
      "body": "return this.selectedTabPageId;"
    },
    "getClickedLinkLabel": {
      "description": "Label of the last clicked right-hand link",
      "returnType": "string",
      "body": "return this.clickedLinkLabel;"
    },
    "getClickedLinkStoryId": {
      "description": "Story id of the last clicked link",
      "returnType": "string",
      "body": "return this.clickedLinkStoryId;"
    },
    "getClickedLinkPageId": {
      "description": "Page id of the last clicked link",
      "returnType": "string",
      "body": "return this.clickedLinkPageId;"
    },
    "getClickedLinkNewTab": {
      "description": "Whether the link should open in a new tab",
      "returnType": "boolean",
      "body": "return this.clickedLinkNewTab;"
    }
  },
  "events": {
    "onTabSelect": {
      "description": "Fires when a left-hand tab is selected"
    },
    "onLinkClick": {
      "description": "Fires when a right-hand link is clicked"
    }
  }
}