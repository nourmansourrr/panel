{
  "id": "com.custom.filterbar",
  "version": "1.1.0",
  "name": "Filter Bar",
  "description": "Date, group and YTD/MTD toggle bar",
  "newInstancePrefix": "FilterBar",
  "vendor": "Custom",
  "eula": "",
  "license": "",
  "icon": "",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-custom-filterbar",
      "url": "https://nourmansourrr.github.io/panel/filterbar/main.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "builder",
      "tag": "com-custom-filterbar-builder",
      "url": "https://nourmansourrr.github.io/panel/filterbar/builder.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-custom-filterbar-styling",
      "url": "https://nourmansourrr.github.io/panel/filterbar/styling.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "width": {
      "type": "integer",
      "default": 1200
    },
    "height": {
      "type": "integer",
      "default": 56
    },
    "granularity": {
      "type": "string",
      "default": "month"
    },
    "dateValue": {
      "type": "string",
      "default": ""
    },
    "mode": {
      "type": "string",
      "default": "YTD"
    },
    "groupsJson": {
      "type": "string",
      "default": "[{\"id\":\"AQH\",\"label\":\"AQH\"}]"
    },
    "selectedGroup": {
      "type": "string",
      "default": ""
    },
    "startDate": {
      "type": "string",
      "default": ""
    },
    "endDate": {
      "type": "string",
      "default": ""
    },
    "startKey": {
      "type": "string",
      "default": ""
    },
    "endKey": {
      "type": "string",
      "default": ""
    },
    "showDate": {
      "type": "boolean",
      "default": true
    },
    "showGroup": {
      "type": "boolean",
      "default": true
    },
    "showToggle": {
      "type": "boolean",
      "default": true
    },
    "dateLabel": {
      "type": "string",
      "default": "DATE:"
    },
    "groupLabel": {
      "type": "string",
      "default": "GROUP:"
    },
    "dateLocale": {
      "type": "string",
      "default": "en-GB"
    },
    "keyFormat": {
      "type": "string",
      "default": "yyyyMM"
    },
    "minDate": {
      "type": "string",
      "default": ""
    },
    "maxDate": {
      "type": "string",
      "default": ""
    },
    "yearsBack": {
      "type": "integer",
      "default": 5
    },
    "yearsForward": {
      "type": "integer",
      "default": 1
    },
    "fontFamily": {
      "type": "string",
      "default": "Inter, 'Segoe UI', Arial, sans-serif"
    },
    "backgroundColor": {
      "type": "string",
      "default": "#1c2b40"
    },
    "labelColor": {
      "type": "string",
      "default": "#9aa7b8"
    },
    "labelFontSize": {
      "type": "integer",
      "default": 13
    },
    "labelFontWeight": {
      "type": "integer",
      "default": 600
    },
    "labelLetterSpacing": {
      "type": "number",
      "default": 0.5
    },
    "labelUppercase": {
      "type": "boolean",
      "default": true
    },
    "valueColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "valueFontSize": {
      "type": "integer",
      "default": 17
    },
    "valueFontWeight": {
      "type": "integer",
      "default": 600
    },
    "chevronColor": {
      "type": "string",
      "default": "#cfd6df"
    },
    "dividerColor": {
      "type": "string",
      "default": "#3a4a60"
    },
    "showDivider": {
      "type": "boolean",
      "default": true
    },
    "itemGap": {
      "type": "integer",
      "default": 28
    },
    "paddingX": {
      "type": "integer",
      "default": 24
    },
    "toggleBg": {
      "type": "string",
      "default": "#26364d"
    },
    "toggleBorderColor": {
      "type": "string",
      "default": "#4a5a70"
    },
    "toggleActiveBg": {
      "type": "string",
      "default": "#ffffff"
    },
    "toggleActiveColor": {
      "type": "string",
      "default": "#1c2b40"
    },
    "toggleInactiveColor": {
      "type": "string",
      "default": "#c4ccd8"
    },
    "toggleRadius": {
      "type": "integer",
      "default": 6
    },
    "toggleFontSize": {
      "type": "integer",
      "default": 14
    },
    "toggleFontWeight": {
      "type": "integer",
      "default": 600
    },
    "modeOptionsJson": {
      "type": "string",
      "default": "[{\"id\":\"MTD\",\"label\":\"MTD\"},{\"id\":\"QTD\",\"label\":\"QTD\"},{\"id\":\"YTD\",\"label\":\"YTD\"}]"
    },
    "yearOptionsJson": {
      "type": "string",
      "default": "[{\"id\":\"CY\",\"label\":\"CY\"},{\"id\":\"PY\",\"label\":\"PY\"}]"
    },
    "yearView": {
      "type": "string",
      "default": "CY"
    },
    "showYearToggle": {
      "type": "boolean",
      "default": true
    },
    "toggleGap": {
      "type": "integer",
      "default": 12
    }
  },
  "methods": {
    "getMode": {
      "description": "Selected period view id (e.g. MTD, QTD, YTD)",
      "returnType": "string",
      "body": "return this.mode;"
    },
    "setMode": {
      "description": "Select a period view by id",
      "parameters": [
        {
          "name": "newMode",
          "type": "string",
          "description": "Period view id"
        }
      ],
      "body": "this.mode = newMode;"
    },
    "getStartDate": {
      "description": "Range start as yyyy-MM-dd",
      "returnType": "string",
      "body": "return this.startDate;"
    },
    "getEndDate": {
      "description": "Range end (selected date) as yyyy-MM-dd",
      "returnType": "string",
      "body": "return this.endDate;"
    },
    "getStartKey": {
      "description": "Range start in the configured key format",
      "returnType": "string",
      "body": "return this.startKey;"
    },
    "getEndKey": {
      "description": "Range end in the configured key format",
      "returnType": "string",
      "body": "return this.endKey;"
    },
    "getGranularity": {
      "description": "month or day",
      "returnType": "string",
      "body": "return this.granularity;"
    },
    "setDate": {
      "description": "Set the selected date (yyyy-MM-dd)",
      "parameters": [
        {
          "name": "isoDate",
          "type": "string",
          "description": "yyyy-MM-dd"
        }
      ],
      "body": "this.dateValue = isoDate;"
    },
    "getGroup": {
      "description": "Selected group id",
      "returnType": "string",
      "body": "return this.selectedGroup;"
    },
    "setGroup": {
      "description": "Select a group by id",
      "parameters": [
        {
          "name": "groupId",
          "type": "string",
          "description": "Group id"
        }
      ],
      "body": "this.selectedGroup = groupId;"
    },
    "setGroups": {
      "description": "Replace the group list with JSON like [{\"id\":\"A\",\"label\":\"A\"}]",
      "parameters": [
        {
          "name": "json",
          "type": "string",
          "description": "JSON array"
        }
      ],
      "body": "this.groupsJson = json;"
    },
    "getYearView": {
      "description": "Selected year view id (e.g. CY, PY)",
      "returnType": "string",
      "body": "return this.yearView;"
    },
    "setYearView": {
      "description": "Select a year view by id",
      "parameters": [
        {
          "name": "viewId",
          "type": "string",
          "description": "Year view id"
        }
      ],
      "body": "this.yearView = viewId;"
    }
  },
  "events": {
    "onChange": {
      "description": "Fires when date, group or YTD/MTD changes"
    }
  }
}